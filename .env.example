# Pulse environment variables. Copy to .env.local and fill in.
# Guest mode runs with none of these; auth + sync + push need them.

# Supabase project (Supabase → Settings → API)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Web Push (closed-app notifications). Public VAPID key — safe to expose to the
# browser. Generate a keypair with:
#   node -e "const c=require('crypto');const e=c.createECDH('prime256v1');e.generateKeys();const b=x=>x.toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');console.log('public',b(e.getPublicKey()));console.log('private',b(e.getPrivateKey()))"
# The PRIVATE key is NOT set here — it lives only as the `VAPID_PRIVATE_KEY`
# secret on the `send-push` Supabase Edge Function.
PUBLIC_VAPID_PUBLIC_KEY=
